{
  "name": "@bompus/house-rules",
  "version": "0.17.0",
  "description": "Composable working rules and skills for AI coding agents",
  "homepage": "https://github.com/bompus/house-rules#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bompus/house-rules.git"
  },
  "bin": {
    "house-rules": "compose.mjs"
  },
  "files": [
    "compose.mjs",
    "composition.mjs",
    "rule-references.mjs",
    "config.mjs",
    "config-view.mjs",
    "setup.mjs",
    "rules/",
    "skills/",
    "!skills/*/test/",
    "!**/__pycache__/",
    "docs/",
    "!docs/npm-release.md",
    "!docs/assets/",
    "examples/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "oxfmt --check && oxlint --deny-warnings . && tsc --noEmit -p tsconfig.check.json && ruff format --check . && ruff check . && bash scripts/check-shell.sh",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}

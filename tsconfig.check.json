{
  // The type check in `npm run check`. Linting reads tsconfig.json, which
  // covers every folder; this file only narrows what `bun --check` checks.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    // Sample pages the stock-UI scanner reads as input; they are not run.
    "skills/*/test/fixtures",
    // Run from a scratch folder with playwright-core, which the repository does not install (see its header).
    "docs/assets/build-assets.ts"
  ]
}

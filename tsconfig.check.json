{
  // The type check in `npm run check`. Linting reads tsconfig.json, which
  // covers every folder; this file only narrows what tsc checks.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    // Sample pages the stock-UI scanner reads as input; they are not run.
    "skills/*/test/fixtures"
  ]
}
